<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    {% apply inline_css(source('@email_css/welcome.css')) %}
    <h1>Réinitialisation du mot de passe pour {{ username }}</h1>
    <p>Vous avez demandé à réinitialiser votre mot de passe. Cliquez sur le lien ci-dessous pour le faire :</p>
    <a href="{{ path('reset-password', {'token': token}) }}">Réinitialiser mon mot de passe</a>
    {% endapply %}
</body>
</html>